{
  "name": "@esteban-ll-aguilar/harness-cli",
  "version": "1.3.0",
  "description": "Production-grade multi-agent harness for SDD-BDD-TDD software development. RAG memory (BM25), Obsidian vault, MCP server, agent auto-generation. Compatible with Claude, Codex, OpenCode, Kimi, Qwen, DeepSeek, and any AI tool.",
  "main": "src/cli.js",
  "bin": {
    "harness": "bin/harness.js",
    "harness-mcp": "bin/harness-mcp.js"
  },
  "scripts": {
    "test": "node tests/runner.js",
    "test:unit": "node tests/runner.js",
    "test:smoke": "node bin/harness.js --version && node bin/harness.js help && npm pack --dry-run",
    "release:check": "node src/release-check.js",
    "prepublishOnly": "node tests/runner.js"
  },
  "keywords": [
    "harness",
    "sdd",
    "bdd",
    "tdd",
    "ai-agent",
    "multi-agent",
    "mcp",
    "model-context-protocol",
    "rag",
    "bm25",
    "claude",
    "codex",
    "kimi",
    "deepseek",
    "qwen",
    "opencode",
    "spec-driven",
    "behavior-driven",
    "test-driven",
    "obsidian"
  ],
  "author": {
    "name": "esteban-ll-aguilar",
    "url": "https://github.com/esteban-ll-aguilar"
  },
  "license": "MIT",
  "homepage": "https://github.com/esteban-ll-aguilar/harness-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esteban-ll-aguilar/harness-cli.git"
  },
  "bugs": {
    "url": "https://github.com/esteban-ll-aguilar/harness-cli/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
